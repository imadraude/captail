<!-- Captail operations-board theme (.NET 9 WPF).
     High-contrast, low-overdraw controls for a capture utility that stays
     open beside fullscreen games. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============ COLORS ============ -->
  <Color x:Key="ColorBgDesktop">#FF070A11</Color>
  <Color x:Key="ColorBgWindow">#FF0C111B</Color>
  <Color x:Key="ColorBgWindowTop">#FF101724</Color>
  <Color x:Key="ColorBgWindowBottom">#FF0A0F18</Color>
  <Color x:Key="ColorBgSurface">#FF141C29</Color>
  <Color x:Key="ColorBgControl">#FF090E17</Color>
  <Color x:Key="ColorBgHover">#FF1B2636</Color>
  <Color x:Key="ColorBorder">#FF29364A</Color>
  <Color x:Key="ColorBorderControl">#FF35445A</Color>
  <Color x:Key="ColorDivider">#FF253044</Color>
  <Color x:Key="ColorTextPrimary">#FFF7F4EB</Color>
  <Color x:Key="ColorTextSecondary">#FFAAB5C6</Color>
  <Color x:Key="ColorTextMuted">#FF8492A7</Color>
  <Color x:Key="ColorTextValue">#FFE8EDF5</Color>
  <Color x:Key="ColorAccent">#FFFF705A</Color>
  <Color x:Key="ColorAccentHover">#FFFF8A77</Color>
  <Color x:Key="ColorAccentDim">#FFD95240</Color>
  <Color x:Key="ColorOnAccent">#FF250B07</Color>
  <Color x:Key="ColorAccentSubtle">#2BFF705A</Color>
  <Color x:Key="ColorAccentChipBg">#18FF705A</Color>
  <Color x:Key="ColorAccentChipBorder">#55FF705A</Color>
  <Color x:Key="ColorFocus">#FF79AEFF</Color>
  <Color x:Key="ColorFocusSubtle">#2479AEFF</Color>
  <Color x:Key="ColorSuccess">#FF5ED6B2</Color>
  <Color x:Key="ColorError">#FFF2B84B</Color>
  <Color x:Key="ColorDanger">#FFFF5F63</Color>
  <Color x:Key="ColorToggleOffTrack">#FF2B3749</Color>
  <Color x:Key="ColorToggleKnob">#FFF7F4EB</Color>
  <Color x:Key="ColorRingIdle">#FF66758A</Color>

  <SolidColorBrush x:Key="BgDesktopBrush" Color="{StaticResource ColorBgDesktop}"/>
  <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource ColorBgWindow}"/>
  <LinearGradientBrush x:Key="BgWindowGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource ColorBgWindowTop}" Offset="0"/>
    <GradientStop Color="{StaticResource ColorBgWindowBottom}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource ColorBgSurface}"/>
  <SolidColorBrush x:Key="BgControlBrush" Color="{StaticResource ColorBgControl}"/>
  <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource ColorBgHover}"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource ColorBorder}"/>
  <SolidColorBrush x:Key="BorderControlBrush" Color="{StaticResource ColorBorderControl}"/>
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource ColorDivider}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>
  <SolidColorBrush x:Key="TextValueBrush" Color="{StaticResource ColorTextValue}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource ColorAccentDim}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColorOnAccent}"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource ColorAccentSubtle}"/>
  <SolidColorBrush x:Key="AccentChipBgBrush" Color="{StaticResource ColorAccentChipBg}"/>
  <SolidColorBrush x:Key="AccentChipBorderBrush" Color="{StaticResource ColorAccentChipBorder}"/>
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource ColorFocus}"/>
  <SolidColorBrush x:Key="FocusSubtleBrush" Color="{StaticResource ColorFocusSubtle}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
  <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="{StaticResource ColorToggleOffTrack}"/>
  <SolidColorBrush x:Key="ToggleKnobBrush" Color="{StaticResource ColorToggleKnob}"/>
  <SolidColorBrush x:Key="RingIdleBrush" Color="{StaticResource ColorRingIdle}"/>

  <!-- ============ TYPOGRAPHY ============ -->
  <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSizeCaption">10.5</sys:Double>
  <sys:Double x:Key="FontSizeSmall">11.5</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeTitle">16</sys:Double>

  <CornerRadius x:Key="RadiusWindow">12</CornerRadius>
  <CornerRadius x:Key="RadiusGroup">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>

