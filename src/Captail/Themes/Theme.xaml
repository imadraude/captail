  <Geometry x:Key="IconPlay">M8 5v14l11-7z</Geometry>
  <Geometry x:Key="IconPause">M8 5h3v14H8z M14 5h3v14h-3z</Geometry>
  <Geometry x:Key="IconFullscreen">M8 3H3v5 M16 3h5v5 M8 21H3v-5 M16 21h5v-5</Geometry>
  <Geometry x:Key="IconExitFullscreen">M3 8h5V3 M21 8h-5V3 M3 16h5v5 M21 16h-5v5</Geometry>
  <Geometry x:Key="IconRefresh">M20 6v5h-5 M4 18v-5h5 M6.1 9a7 7 0 0 1 11.7-2.6L20 9 M4 15l2.2 2.6A7 7 0 0 0 17.9 15</Geometry>
  <Geometry x:Key="IconCheck">M5 12l4 4L19 6</Geometry>

  <Geometry x:Key="IconGitHub">M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 7.7a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86V21c0 .27.18.58.69.48A10 10 0 0 0 12 2z</Geometry>
  <Geometry x:Key="IconInfo">M12 10v7 M12 7h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z</Geometry>
  <Geometry x:Key="IconIssue">M12 8v5 M12 17h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z</Geometry>
  <Geometry x:Key="IconFeature">M12 7v10 M7 12h10 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z</Geometry>

  <!-- ============ TEXT STYLES ============ -->
  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Foreground" Value="{StaticResource FocusBrush}"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    <Setter Property="Margin" Value="2,20,2,7"/>
  </Style>

  <Style x:Key="RowLabelText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
  </Style>

  <Style x:Key="LoadingIndicator" TargetType="Control">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Viewbox Stretch="Uniform">
            <Grid Width="24" Height="24">
              <Ellipse Margin="2" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" Opacity="0.14"/>
              <Ellipse x:Name="LoadingArc" Margin="2" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2.2" StrokeDashArray="8,20"
                       StrokeDashCap="Round" Fill="Transparent"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                            From="0" To="360" Duration="0:0:0.85"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </Grid>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="HelpTipTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>

  <Style x:Key="HelpTipBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="LineHeight" Value="17"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MaxWidth" Value="300"/>
  </Style>

  <Style x:Key="HelpToolTip" TargetType="ToolTip">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Placement" Value="Mouse"/>
    <Setter Property="HorizontalOffset" Value="12"/>
    <Setter Property="VerticalOffset" Value="10"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border x:Name="TipPanel"
                  Background="{StaticResource BgHoverBrush}"
                  BorderBrush="{StaticResource BorderControlBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="13,11"
                  Opacity="0"
                  SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="7"
                                Direction="270" Opacity="0.45"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform Y="4"/>
            </Border.RenderTransform>
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="TipPanel"
                                   Storyboard.TargetProperty="Opacity"
                                   To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="TipPanel"
                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                   To="0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- String-valued tooltips are materialized by WPF as ToolTip controls.
       Base them on the same surface and spacing as the richer help cards. -->
  <Style TargetType="ToolTip" BasedOn="{StaticResource HelpToolTip}"/>

  <!-- Modern accessible focus visual styles for keyboard navigation -->
  <Style x:Key="CaptailFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource FocusBrush}"
                  BorderThickness="2"
                  CornerRadius="6"
                  Margin="-2"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptailFocusVisualRound">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource FocusBrush}"
                  BorderThickness="2"
                  CornerRadius="13"
                  Margin="-2"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptailFocusVisualSmall">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource FocusBrush}"
                  BorderThickness="2"
                  CornerRadius="4"
                  Margin="-1"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HelpIconButton" TargetType="Button">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Margin" Value="5,0,0,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource CaptailFocusVisualSmall}"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
    <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
    <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Badge"
                  Width="15" Height="15" CornerRadius="8"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource RingIdleBrush}" BorderThickness="1">
            <Path Data="M5.8 5.2A3.1 3.1 0 0 1 12 5.6c0 2.4-2.8 2.6-2.8 4.4 M9.2 13.2v.1"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="10" Height="11" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Badge" Property="Background"
                      Value="{StaticResource AccentSubtleBrush}"/>
              <Setter TargetName="Badge" Property="BorderBrush"
                      Value="{StaticResource AccentDimBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Badge" Property="Opacity" Value="0.72"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsGroup" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="RowDivider" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
    <Setter Property="Margin" Value="13,0"/>
  </Style>

  <!-- ============ BUTTONS ============ -->
  <Style x:Key="AccentButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Padding" Value="16,13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource CaptailFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource WindowBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Quiet actions such as "Change..." -->
  <Style x:Key="SubtleButton" TargetType="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource CaptailFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource BgControlBrush}"
                  BorderBrush="{StaticResource BorderControlBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RecordActionButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource BgControlBrush}"
                  BorderBrush="{StaticResource BorderControlBrush}" BorderThickness="1"
                  CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ClipActionButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Width" Value="31"/>
    <Setter Property="Height" Value="31"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="3,0,0,0"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
  </Style>

  <Style x:Key="IdentifyDisplayButton" TargetType="Button">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentDimBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource CaptailFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
