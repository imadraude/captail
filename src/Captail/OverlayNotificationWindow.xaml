<Window x:Class="Captail.OverlayNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" Height="68"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False">
    <Border x:Name="Card"
            Margin="8"
            Background="#F214181B"
            BorderBrush="#FF2A3439"
            BorderThickness="1"
            CornerRadius="9"
            Padding="10,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                              Direction="270" Color="#000000" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="NotificationIcon" Width="22" Height="22"
                  VerticalAlignment="Center">
                <Ellipse x:Name="IconRing" Stroke="#FF63E0BD" StrokeThickness="1.6"/>
                <TextBlock x:Name="IconText" Text="✓"
                           Foreground="#FF63E0BD"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="11.5" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock x:Name="TitleText"
                           Foreground="#FFF1F5F4"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DetailText"
                           Foreground="#FF94A0A6"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="10.5"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.ColumnSpan="2"
                    Height="1.5" VerticalAlignment="Bottom"
                    Margin="-10,0,-10,-8"
                    CornerRadius="0,0,9,9"
                    Background="#1E2A3439"
                    ClipToBounds="True">
                <Border x:Name="LifeBar"
                        Background="#FF63E0BD"
                        RenderTransformOrigin="0,0.5"
                        HorizontalAlignment="Stretch">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LifeScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
