<Window x:Class="Captail.OverlayNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="324" Height="78"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False">
    <Border x:Name="Card"
            Margin="8"
            Background="#F5181D20"
            BorderBrush="#FF2B3236"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                              Direction="270" Color="#000000" Opacity="0.30"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="12,9,12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="NotificationIcon" Width="26" Height="26"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                    <Ellipse x:Name="IconSurface" Fill="#2063E0BD"/>
                    <Ellipse x:Name="IconRing" Stroke="#7063E0BD" StrokeThickness="1"/>
                    <Viewbox Width="14" Height="14"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Width="14" Height="14">
                            <Path x:Name="IconPath"
                                  Stroke="#FF63E0BD"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  SnapsToDevicePixels="True"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="IconText"
                               Visibility="Collapsed"
                               Foreground="#FF63E0BD"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TitleText"
                               Foreground="#FFE7ECEA"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="#FF9AA5AB"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="10.5"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Height="2"
                    Margin="12,0,12,7"
                    CornerRadius="1"
                    Background="#FF252C30"
                    ClipToBounds="True">
                <Border x:Name="LifeBar"
                        Background="#FF63E0BD"
                        RenderTransformOrigin="0,0.5"
                        HorizontalAlignment="Stretch">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LifeScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
