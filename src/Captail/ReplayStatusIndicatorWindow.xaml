<Window x:Class="Captail.ReplayStatusIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="18" Height="18"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Opacity="0.75">
    <Grid x:Name="IndicatorRoot" Width="18" Height="18"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          SnapsToDevicePixels="True" UseLayoutRounding="True"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Rectangle Width="18" Height="18" RadiusX="5" RadiusY="5"
                   Fill="#E60C111B" Stroke="#B335445A" StrokeThickness="1"/>

        <!-- The in-game indicator deliberately reuses the same centered
             rounded-square + dot language as the Captail 0.7 app mark. -->
        <Grid Width="12" Height="12"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle x:Name="StateRing"
                       Width="12" Height="12"
                       Stroke="#FFFF705A" StrokeThickness="1.35"
                       RadiusX="3" RadiusY="3"
                       StrokeDashCap="Round"
                       StrokeDashArray="4.4 3.1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse x:Name="CenterDot" Width="4" Height="4"
                     Fill="#FFFF705A"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="SavedGlyph" Visibility="Collapsed"
                  Data="M 2.7 6.2 L 4.8 8.3 L 9.6 3.7"
                  Stroke="#FF5ED6B2" StrokeThickness="1.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
            <Path x:Name="ErrorGlyph" Visibility="Collapsed"
                  Data="M 3.4 3.4 L 8.6 8.6 M 8.6 3.4 L 3.4 8.6"
                  Stroke="#FFFF5F63" StrokeThickness="1.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Grid>
</Window>
