<Window x:Class="Captail.ReplayStatusIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="18" Height="18"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        Opacity="0.75">
    <Grid x:Name="IndicatorRoot" Width="18" Height="18"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Ellipse Width="18" Height="18"
                 Fill="#A611171A" Stroke="#80344047" StrokeThickness="1"/>

        <Grid Width="14" Height="14">
            <Ellipse Stroke="#36506067" StrokeThickness="1"/>
            <Ellipse x:Name="StateRing"
                     Stroke="#FF63E0BD" StrokeThickness="1.4"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     StrokeDashArray="5.5 2.5"/>
            <Ellipse x:Name="CenterDot" Width="2.5" Height="2.5"
                     Fill="#FF63E0BD"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="SavedGlyph" Visibility="Collapsed"
                  Data="M2.5 6.8 L5.2 9.4 L11.5 3.4"
                  Stroke="#FF63E0BD" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Stretch="None"/>
            <Path x:Name="ErrorGlyph" Visibility="Collapsed"
                  Data="M3.8 3.8 L10.2 10.2 M10.2 3.8 L3.8 10.2"
                  Stroke="#FFFF5F63" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="None"/>
        </Grid>
    </Grid>
</Window>
