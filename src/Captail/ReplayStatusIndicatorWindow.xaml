<Window x:Class="Captail.ReplayStatusIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="18" Height="18"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        Opacity="0.75">
    <Grid x:Name="IndicatorRoot" Width="18" Height="18"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Ellipse Width="18" Height="18"
                 Fill="#A611171A" Stroke="#80344047" StrokeThickness="1"/>

        <Grid Width="14" Height="14">
            <Ellipse Stroke="#36506067" StrokeThickness="1"/>
            <Ellipse x:Name="StateRing"
                     Stroke="#FF63E0BD" StrokeThickness="1.3"
                     StrokeDashCap="Round"
                     StrokeDashArray="5.93 4.3"/>
            <Ellipse x:Name="CenterDot" Width="3" Height="3"
                     Fill="#FF63E0BD"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="SavedGlyph" Visibility="Collapsed"
                  Data="M 3.8 7.2 L 5.9 9.3 L 10.2 4.7"
                  Stroke="#FF63E0BD" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
            <Path x:Name="ErrorGlyph" Visibility="Collapsed"
                  Data="M 4.4 4.4 L 9.6 9.6 M 9.6 4.4 L 4.4 9.6"
                  Stroke="#FFFF5F63" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Grid>
</Window>
